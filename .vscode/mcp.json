{
  "inputs": [],
  "servers": {
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "type": "http"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chromium"]
    },
    "android-adb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@landicefu/android-adb-mcp-server"],
      "env": {
        "PATH": "C:\\platform-tools;${env:PATH}"
      }
    }
  }
}
