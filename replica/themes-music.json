{
  "_about": "Themes for a local Android music player, matched against reviews in English, Spanish, Portuguese, Italian, French, German, Russian, Ukrainian, Turkish, Polish and Indonesian. Patterns are case-insensitive Python regexes.",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease add\\b", "\\bwould be (nice|great|good|helpful)\\b", "\\bone suggestion\\b", "\\bthe ability to\\b",
    "estar[ií]a (bueno|mejor)", "me gustar[ií]a", "falta(r[ií]an)?\\b", "lo conseguir[ií]a",
    "gostaria", "seria bom",
    "sarebbe", "serait super", "est.il possible",
    "gibt es .* die m[öo]glichkeit",
    "хотелось бы", "пожелани",
    "daha (g[üu]zel|iyi) olur", "d[üu]zeltseniz",
    "ce serait"
  ],
  "themes": [
    {"id": "covers", "label": "Album art: download errors, wrong or lost covers", "kind": "complaint",
     "patterns": ["album (art|cover)", "\\bcover art\\b", "car[áa]tulas?", "portadas?", "\\bcapas?\\b", "copertin", "\\bcover\\b", "pochettes?", "обкладинк", "chain validation", "kapa[kğ]"]},
    {"id": "scan", "label": "Library scan misses files, folders or SD card", "kind": "complaint",
     "patterns": ["\\bdetect", "\\bscann?(er|ing)?\\b", "sd ?(card|kart)", "algıla", "non mi trova", "non trova", "nie wczytuje", "selezionare le cartelle", "no tracks in"]},
    {"id": "playback", "label": "Songs won't play, app freezes, crashes or pauses by itself", "kind": "complaint",
     "patterns": ["does not play", "doesn'?t play", "unable to play", "did not make a sound", "no est[áa] reproduciendo", "n[ãa]o toca", "n[ãa]o est[áa] reproduzindo", "deja de reproducir", "se pausa solo", "trabarse", "detenerse", "не отвечает", "выкидывает", "глючит", "non funziona", "player will remain empty"]},
    {"id": "updates", "label": "Regressions after updates", "kind": "complaint",
     "patterns": ["after (the )?(recent |last )?updates?", "recent update", "nach updates", "últimas actualizaciones", "[úu]ltimas? atualiza", "precedente versione", "останнього оновлення", "последн\\w* обновлени", "an update"]},
    {"id": "backup", "label": "Settings not saved, nagging backup prompt", "kind": "complaint",
     "patterns": ["backup", "copia de seguridad", "configura[çc][õo]es n[ãa]o s[ãa]o salvas", "no me guarda"]},
    {"id": "license", "label": "Paid license or ad-free lost when changing phone", "kind": "complaint",
     "patterns": ["pagu[ée] por no tener anuncios", "(?<![а-яё])ключ(?![а-яё])", "paid for", "license", "licencia"]},
    {"id": "lyrics", "label": "Lyrics missing, garbled or break playback", "kind": "complaint",
     "patterns": ["keine lyrics", "letras? de las canciones se cambian", "actualizo la letra", "s[öo]zleri yok", "buscar una letra"]},
    {"id": "audio", "label": "Noise, crackle or weak effects with EQ", "kind": "complaint",
     "patterns": ["шум", "kratzger[äa]usch", "sound effects needs", "crackl", "distort"]},
    {"id": "scale", "label": "Slows down or gives up with big libraries", "kind": "complaint",
     "patterns": ["larger libraries", "starts to give up", "struggles"]},
    {"id": "layout", "label": "Rigid layout: grid size, tabs, stretched UI, no custom background", "kind": "request",
     "patterns": ["3x3", "tama[ñn]o de los [áa]lbumes", "interfaccia", "широкоформат", "редактор интерфейса", "fond d'[ée]cran", "temas que tienen pero no cambian", "browser tabs", "schede posizionate"]},
    {"id": "marquee", "label": "Long title/artist info cut off, should scroll", "kind": "request",
     "patterns": ["scroll on the play screen", "desplaz[áa]ndose progresivamente"]},
    {"id": "android_auto", "label": "No Android Auto", "kind": "request",
     "patterns": ["android auto"]},
    {"id": "sorting", "label": "Sorting: multi-disc albums, alphabet index, order breaks after edits", "kind": "request",
     "patterns": ["multi-disc", "orden alfab[ée]tico", "se posiciona en el [úu]ltimo lugar"]},
    {"id": "loudness", "label": "Uneven volume between songs (no normalization)", "kind": "request",
     "patterns": ["lautst[äa]rke"]},
    {"id": "queue_resume", "label": "Resume a full shuffle where it stopped", "kind": "request",
     "patterns": ["reprendre la liste"]},
    {"id": "lockscreen", "label": "Lock screen / background art behaves wrong", "kind": "complaint",
     "patterns": ["екрана блокування", "in background, the album cover"]}
  ]
}
